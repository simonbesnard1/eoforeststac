FROM nginxinc/nginx-unprivileged:1.28.2-alpine

COPY --chown=101:101 deploy/vm/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 webapp/ /usr/share/nginx/html/
COPY --chown=101:101 deploy/vm/config.js /usr/share/nginx/html/config.js

USER 101:101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1
